# HTML: short browser cache, longer edge cache once a Cache Rule is enabled.
/
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

/partners
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

# Images: 7 days in the browser. Variants are generated by scripts/optimize-images.py.
/images/*
  Cache-Control: public, max-age=604800

# Fonts: filenames are versioned, cache for one year.
/webfonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=604800

/style.min.css
  Cache-Control: public, max-age=604800

/*.min.js
  Cache-Control: public, max-age=604800
