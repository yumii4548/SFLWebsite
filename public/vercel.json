{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/partner", "destination": "/partners.html" },
    { "source": "/partners", "destination": "/partners.html" }
  ],
  "headers": [
    { "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=300" }
      ]
    },
    { "source": "/robots.txt",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] },
    { "source": "/sitemap.xml",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] },
    { "source": "/images/(.*)",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/css/(.*)",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/style.min.css",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/common.min.js",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/script.min.js",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/webfonts/(.*)",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
